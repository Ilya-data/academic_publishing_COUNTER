model Model
	culture: en-GB
	defaultPowerBIDataSourceVersion: powerBI_V3
	sourceQueryCulture: en-DE
	valueFilterBehavior: independent
	dataAccessOptions
		legacyRedirects
		returnErrorValuesAsNull

annotation __PBI_TimeIntelligenceEnabled = 0

annotation PBI_ProTooling = ["DevMode"]

annotation PBI_QueryOrder = ["fact_usage","fact_denials","dim_title","dim_institution","dim_date","_Measures","DataFolder"]

ref table fact_usage
ref table fact_denials
ref table dim_title
ref table dim_institution
ref table dim_date
ref table _Measures

ref cultureInfo en-GB

