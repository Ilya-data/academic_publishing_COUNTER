		annotation SummarizationSetBy = Automatic

	column metric_type
		dataType: string
		lineageTag: c99f2d00-f056-424b-a9ed-79f4a38eaa2c
		summarizeBy: none
		sourceColumn: metric_type

		annotation SummarizationSetBy = Automatic

	column metric_count
		dataType: int64
		formatString: 0
		lineageTag: 2ba63c18-2aac-4adb-ada7-1bde37b74bc2
		summarizeBy: sum
		sourceColumn: metric_count

		annotation SummarizationSetBy = Automatic

	partition fact_denials = m
		mode: import
		source =
				let
				    Source = Csv.Document(File.Contents(DataFolder & "fact_denials.csv"),[Delimiter=",", Columns=5, QuoteStyle=QuoteStyle.None]),
				    #"Promoted Headers" = Table.PromoteHeaders(Source, [PromoteAllScalars=true]),
				    #"Changed Type" = Table.TransformColumnTypes(#"Promoted Headers",{{"month_start", type date}, {"institution_id", Int64.Type}, {"title_id", Int64.Type}, {"metric_type", type text}, {"metric_count", Int64.Type}})
				in
				    #"Changed Type"

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

