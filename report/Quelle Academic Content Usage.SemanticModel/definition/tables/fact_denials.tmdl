		summarizeBy: none
		sourceColumn: month_start

		annotation SummarizationSetBy = Automatic

		annotation UnderlyingDateTimeDataType = Date

	column institution_id
		dataType: int64
		formatString: 0
		lineageTag: 3ed6c882-4cf2-454b-92f8-faf9cc11295b
		summarizeBy: none
		sourceColumn: institution_id

		annotation SummarizationSetBy = Automatic

	column title_id
